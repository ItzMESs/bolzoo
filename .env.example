# Upstash Redis (Vercel dashboard -> Storage -> "Upstash for Redis" -г холбовол автоматаар нэмэгдэнэ)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (имэйл мэдэгдэл илгээхэд) — https://resend.com дээр бүртгүүлээд API key авна
RESEND_API_KEY=
# Домэйноо баталгаажуулсны дараа өөрийн хаягаа энд бичнэ, эс бол Resend-ийн тест хаягийг ашиглана
RESEND_FROM="Bolzoo Urilga <onboarding@resend.dev>"

# byl.mn (QPay төлбөр авахад) — https://byl.mn дээр project үүсгээд API token авна
# Эдгээрийг тохируулаагүй бол урилга ҮНЭГҮЙ хэвээр ажиллана (төлбөрийн алхам харагдахгүй)
BYL_API_TOKEN=
BYL_PROJECT_ID=
# byl.mn dashboard-ийн Settings -> Webhooks хэсэгт https://<таны-домэйн>/api/webhooks/byl-г
# бүртгэхэд өгөх "signing secret"-ийг энд бичнэ
BYL_WEBHOOK_SECRET=
